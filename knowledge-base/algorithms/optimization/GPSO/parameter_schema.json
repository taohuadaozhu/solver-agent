{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GPSO Parameter Schema",
  "type": "object",
  "properties": {
    "population_size": {
      "type": "integer",
      "title": "Population Size",
      "minimum": 4,
      "default": 100
    },
    "num_generations": {
      "type": "integer",
      "title": "Number of Generations",
      "minimum": 1,
      "default": 200
    },
    "mutation_rate": {
      "type": "number",
      "title": "Mutation Rate",
      "minimum": 0.0,
      "maximum": 1.0,
      "default": 0.1
    },
    "crossover_rate": {
      "type": "number",
      "title": "Crossover Rate",
      "minimum": 0.0,
      "maximum": 1.0,
      "default": 0.9
    }
  },
  "required": [
    "population_size",
    "num_generations"
  ]
}